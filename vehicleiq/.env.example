# ============================================================
# VehicleIQ — Environment Configuration
# ============================================================
#
# Copy this file to .env and fill in values for your setup.
# All paths default to subdirectories of the project root.
#

# ------------------------------------------------------------------
# Application base directory for runtime data
# All storage (db, faiss, crops, videos) will live under this path.
# Default: ./storage  (relative to where you run the server from)
# ------------------------------------------------------------------
VEHICLEIQ_DATA_DIR=./storage

# ------------------------------------------------------------------
# SQLite database path
# ------------------------------------------------------------------
VEHICLEIQ_DB_PATH=./storage/db/vehicleiq.db

# ------------------------------------------------------------------
# FAISS index paths
# ------------------------------------------------------------------
VEHICLEIQ_FAISS_PATH=./storage/faiss/vehicle_gallery.faiss
VEHICLEIQ_FAISS_IDS_PATH=./storage/faiss/vehicle_ids.json

# ------------------------------------------------------------------
# Video upload + crop storage
# ------------------------------------------------------------------
VEHICLEIQ_VIDEOS_DIR=./storage/videos
VEHICLEIQ_CROPS_DIR=./storage/crops

# ------------------------------------------------------------------
# SigLIP2 model (HuggingFace Hub ID)
# ------------------------------------------------------------------
SIGLIP2_MODEL_ID=google/siglip2-base-patch16-224

# ------------------------------------------------------------------
# YOLO model name (downloaded automatically by ultralytics)
# ------------------------------------------------------------------
YOLO_MODEL_NAME=yolo26n.pt

# ------------------------------------------------------------------
# Detection parameters
# ------------------------------------------------------------------
YOLO_CONFIDENCE=0.25
YOLO_IMGSZ=640

# ------------------------------------------------------------------
# Pipeline parameters
# ------------------------------------------------------------------
MAX_TEMPORAL_CROPS=8
EMBEDDING_BATCH_SIZE=32

# ------------------------------------------------------------------
# FastAPI server (used by Streamlit to communicate with backend)
# ------------------------------------------------------------------
VEHICLEIQ_API_URL=http://localhost:8000

# ------------------------------------------------------------------
# Paths to the existing Track 2 artifacts for initial data migration.
# Only needed if you want to seed the database from the S01/c001
# prototype. Leave empty to start with an empty database.
# ------------------------------------------------------------------
TRACK2_DB_PATH=../track2/vehicleiq.db
TRACK2_EMBEDDINGS_PATH=../track2/embeddings/vehicle_embeddings.npy
TRACK2_IDS_PATH=../track2/embeddings/vehicle_ids.json
TRACK2_CROPS_BASE_DIR=../track2
